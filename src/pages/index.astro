---
// Home route: today's daf, the app's main screen. This used to be the "/"
// HashRouter route rendered by App.jsx inside one client-only shell; it is now
// its own Astro page, with its own title and description, wrapping Today.jsx
// as a client:load island (never client:only) so Astro still server-renders
// its real markup.
import Layout from '../layouts/Layout.astro';
import Today from './Today.jsx';
---
<Layout
  title="Havruta: today's daf"
  description="Study today's daf yomi page of Talmud with a study partner that challenges your reading instead of handing you the answer."
  current="Today"
>
  <Today client:load />
</Layout>
